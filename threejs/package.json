{
  "name": "nailong-threejs-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "assets": "node scripts/generate-assets.mjs",
    "assets:nature": "node scripts/prepare-megakit.mjs",
    "assets:lod": "node scripts/prepare-nature-lod.mjs",
    "assets:arena": "node scripts/prepare-arena-assets.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "test": "node --experimental-strip-types --test --test-isolation=none tests/*.test.ts"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/three": "0.186.0",
    "meshoptimizer": "1.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
